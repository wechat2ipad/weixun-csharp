<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Weixun</RootNamespace>
    <AssemblyName>Weixun.Sdk</AssemblyName>
    <PackageId>Weixun.Sdk</PackageId>
    <Version>0.1.0</Version>
    <Authors>weixun</Authors>
    <Description>微寻微信协议 API 的 .NET SDK</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://weixun.site</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wechat2ipad/weixun-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
